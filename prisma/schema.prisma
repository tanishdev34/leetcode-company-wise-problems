
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TimePeriod {
  THIRTY_DAYS
  THREE_MONTHS
  SIX_MONTHS
  MORE_THAN_SIX_MONTHS
  ALL
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String?
  passwordHash     String?
  image            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  accounts         Account[]
  userQuestions    UserQuestion[]
  analysisJobs     AnalysisJob[]
  emailVerified    Boolean        @default(false)
  role             String         @default("user")
  leetcodeUsername    String?
  codeforcesUsername  String?
  emailSubscribed     Boolean        @default(false)

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Company {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  companyQuestions CompanyQuestion[]

  @@index([slug])
}

model Question {
  id               String            @id @default(cuid())
  title            String
  leetcodeUrl      String            @unique
  difficulty       Difficulty
  topics           String[]
  acceptanceRate   Float
  createdAt        DateTime          @default(now())
  userQuestions    UserQuestion[]
  companyQuestions CompanyQuestion[]
  analysisJobs     AnalysisJob[]

  @@index([difficulty])
}

model AnalysisJob {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  status     String   @default("pending")
  language   String
  code       String
  error      String?
  attempts   Int      @default(0)
  maxAttempts Int     @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId, status])
  @@index([userId, questionId, createdAt])
}

model CompanyQuestion {
  id         String     @id @default(cuid())
  questionId String
  companyId  String
  timePeriod TimePeriod
  frequency  Float      @default(0)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([questionId, companyId, timePeriod])
  @@index([questionId])
  @@index([companyId])
}

model UserQuestion {
  id         String    @id @default(cuid())
  userId     String
  questionId String
  solved     Boolean   @default(false)
  solvedAt   DateTime?
  notes      String?
  code       String?
  language   String    @default("cpp")
  hints      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
